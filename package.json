{
  "name": "@quantovainc/qorbit",
  "version": "0.1.0",
  "description": "Quantum secure registration and custody records for orbital objects and satellites. Proves the registration, launch, maneuver, transfer and deorbit of an orbital object, with ML-DSA-65 under FIPS 204 and Quantova time proofs. No operator data ever leaves the party that holds it.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "wasm/qorbit_native.js",
    "wasm/qorbit_native_bg.wasm",
    "wasm/qorbit_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.14"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "space",
    "satellite",
    "orbital-objects",
    "space-situational-awareness",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QOrbit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QOrbit.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QOrbit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0"
  }
}
